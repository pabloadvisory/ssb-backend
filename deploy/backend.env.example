# Store the real file outside the repository at /etc/ssb/backend.env with mode 600.
# Generate independent secrets with: openssl rand -hex 32
SSB_POSTGRES_PASSWORD=replace-with-a-random-hex-secret
SSB_INGEST_API_KEY=replace-with-a-different-random-hex-secret
SSB_EDITORIAL_API_KEY=replace-with-a-third-random-hex-secret
