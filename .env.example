SSB_ENV=development
SSB_LOG_LEVEL=debug
SSB_HTTP_ADDR=:8080
SSB_DATABASE_URL=postgres://ssb:ssb@localhost:5432/ssb?sslmode=disable
SSB_DATABASE_MIN_CONNS=2
SSB_DATABASE_MAX_CONNS=20
SSB_INGEST_API_KEY=local-development-key
SSB_HTTP_READ_HEADER_TIMEOUT=5s
SSB_HTTP_READ_TIMEOUT=15s
SSB_HTTP_WRITE_TIMEOUT=30s
SSB_HTTP_IDLE_TIMEOUT=120s
SSB_SHUTDOWN_TIMEOUT=20s
# Comma-separated proxy networks allowed to supply X-Forwarded-For. Leave empty for direct clients.
# SSB_TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16
SSB_INSTALLATION_RATE_PER_MINUTE=20
SSB_INSTALLATION_RATE_BURST=5
SSB_REALTIME_CONNECTIONS_PER_IP=20
SSB_ABUSE_TRACKED_IP_LIMIT=100000
# Push worker (configure either or both providers)
# SSB_APNS_KEY_PATH=/run/secrets/AuthKey_XXXXXXXXXX.p8
# SSB_APNS_KEY_ID=XXXXXXXXXX
# SSB_APNS_TEAM_ID=XXXXXXXXXX
# SSB_FCM_PROJECT_ID=your-firebase-project
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
SSB_ACTIVITY_ATTRIBUTES_TYPE=FootballMatchAttributes
SSB_PUSH_POLL_INTERVAL=1s
SSB_PUSH_LOCK_DURATION=30s
SSB_PUSH_SEND_TIMEOUT=20s
SSB_PUSH_CONCURRENCY=10
SSB_PUSH_MAX_ATTEMPTS=8
# Transactional outbox consumer (runs in every API replica; leases coordinate replicas)
SSB_OUTBOX_POLL_INTERVAL=250ms
SSB_OUTBOX_LOCK_DURATION=150s
SSB_OUTBOX_PROCESS_TIMEOUT=120s
SSB_OUTBOX_CONCURRENCY=4
SSB_OUTBOX_MAX_ATTEMPTS=10
# Bounded retention; Go durations use hours rather than a "d" suffix.
SSB_MAINTENANCE_INTERVAL=1h
SSB_DELIVERY_RETENTION=720h
SSB_OUTBOX_RETENTION=168h
SSB_ENDPOINT_AUDIT_RETENTION=8760h
SSB_MAINTENANCE_BATCH_SIZE=1000
SSB_QUEUE_HEALTH_INTERVAL=30s
